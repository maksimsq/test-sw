@startuml

' Загальна назва діаграми
title Електронна картотека пацієнтів поліклініки

left to right direction

' --- Визначення акторів ---
actor Лікар as doc
actor Пацієнт as patient
actor Адміністратор as admin

' --- Межі системи та прецеденти всередині ---
rectangle "Система: Електронна картотека пацієнтів" {
  usecase "Переглядати мед. картку пацієнта" as UC1
  usecase "Вносити дані в мед. картку" as UC2
  
  usecase "Переглядати власну мед. картку" as UC3
  usecase "Переглядати список своїх лікарів" as UC4

  usecase "Керувати даними пацієнтів" as UC5
  usecase "Переглядати список лікарів" as UC6
}

' --- Зв'язки між акторами та прецедентами ---
doc -- UC1
doc -- UC2

patient -- UC3
patient -- UC4

admin -- UC5
admin -- UC6

@enduml
